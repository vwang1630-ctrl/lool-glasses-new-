{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lool-work",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lool-work",
      "database_id": "54542c91-b95e-4fbc-b48e-5ad60a974cea",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "OTP_KV",
      "id": "05a7a52e017947d0adbe20f3c3385dfd",
    },
  ],
  "r2_buckets": [
    {
      "binding": "RX_BUCKET",
      "bucket_name": "lool-work-rx",
    },
    {
      "binding": "PRODUCTS_BUCKET",
      "bucket_name": "lool-work-products",
    },
    {
      "binding": "AUDIT_LOGS_BUCKET",
      "bucket_name": "lool-work-audit-logs",
    },
  ],
  "vars": {
    "RESEND_FROM": "noreply@loollook.com",
    "SITE_URL": "https://loollook.com",
  },
  "routes": [
    { "pattern": "loollook.com", "custom_domain": true },
    { "pattern": "www.loollook.com", "custom_domain": true },
  ],
}
