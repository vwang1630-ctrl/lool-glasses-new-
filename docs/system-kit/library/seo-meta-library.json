        "Progressive Lenses — 3-Week Adaptation Guarantee | lool",
        "Virtual Try-On — See Glasses on Your Face | lool"
      ]
    },
    "description": {
      "rule": "150-160 字符，包含行动号召",
      "pattern": "{benefit_statement}. {feature}. {cta}.",
      "examples": [
        "Ageless reading glasses redesigned for the 45-60 generation. Pro-grade lenses, virtual try-on, free shipping. Find your perfect pair.",
